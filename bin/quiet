#!/usr/bin/env python3
"""quiet -- run a gate, keep its output in a file, print one verdict line
(common-rules proposal 23, lever L3).

  quiet [--log FILE] [--label NAME] [--jobs N|auto] -- CMD [ARGS...]

Runs CMD directly (no shell). All of its stdout and stderr go to FILE only
-- never to this process's own stdout. Default FILE is
$TMPDIR/quiet/<label or CMD's basename>-<YYYYmmdd-HHMMSS>.log (created if
needed). Exactly one line is printed to stdout:

  quiet: OK · <detail> · <secs>s · log <path>
  quiet: FAILED · <detail> · <secs>s · log <path>

OK requires CMD's exit code to be 0 AND no failure summary recognised in
its output. FAILED is reported when the exit code is nonzero OR a failure
summary is recognised, even if the exit code was 0 -- the verdict trusts
the runner's own summary line, not just the exit code (see
docs/OPERATING-RULES.md S3: `grep ... && git commit` once shipped a
failing test because grep exits 0 on a line containing "FAILED").

quiet exits with CMD's own exit code (2 if CMD could not be started at
all, e.g. the binary does not exist).

Recognised summary shapes: Python unittest, pytest, `flutter test`,
`flutter analyze` / `dart analyze`. Anything else falls back to the last
non-empty line of output, and OK/FAILED is then decided by exit code
alone.

Exit codes follow the rest of bin/: 0 fine, 1 a finding, 2 could not check.

-- Parallel test suites (proposal 23, lever M-01) --------------------------

`--jobs N` shards a plain `python3 -m unittest discover -s DIR [-p PATTERN]
[-q]` CMD across N OS processes, one per test file matched by PATTERN
(default "test*.py"), and writes one aggregated, unittest-shaped summary
to the log ("Ran <total> tests in <secs>s" / "OK" or "FAILED (failures=N,
errors=M)") -- so the verdict line above is produced exactly as it always
is, from the same `_detect()` this file already used for the sequential
run. Research: parallel unittest shards report 67-81% faster suites
(Trail of Bits, May 2025).

`--jobs` only changes anything when CMD parses as that exact discover
shape; for any other CMD, or when CMD does not parse (a flag this parser
does not know, e.g. `-t`), it is ignored and CMD runs exactly as before --
sequential, unchanged. The project's own CI/`bin/land` command,
`bin/quiet -- python3 -m unittest discover -s tests -q` (no `--jobs`), is
therefore untouched by this feature: parallel running is opt-in.

`--jobs auto` (same as a bare trailing `--jobs`, with no number after it)
resolves to `os.cpu_count() - 2`, floor 2, so a caller does not have to
pick a number by hand.

Shards are dispatched longest-known-first, not in file order: a shard is
one file's own `unittest discover -p <file>` in its own process, and the
whole run is only as fast as the slowest one -- a 575s file among six
15-222s files gives a 610s wall clock if it happens to be submitted last,
no better than serial, because it starts only once a worker frees up.
Submitting it first instead means it starts at t=0 and every faster file
fills in around it. Each file's last measured duration is kept in a small
cache next to the one `tools/tracker/history.py` keeps for the same
reason (see its module docstring) -- `.cache/quiet-shard-durations.json`
under the project root when that root's `.gitignore` already ignores
`.cache/`, else a file under the system temp dir keyed by the root's own
absolute path. A file never timed before (cold cache) sorts after every
timed file, in their original order -- correctness never depends on the
cache, every file still runs exactly once either way.
"""
from __future__ import annotations

import ast
import concurrent.futures
import hashlib
import json
import math
import os
import re
import subprocess
import sys
import tempfile
import time
from pathlib import Path

DETAIL_MAX = 160
_NO_VALUE_DISCOVER_FLAGS = {
    "-q", "--quiet", "-v", "--verbose", "-b", "--buffer", "-f", "--failfast",
    "-c", "--catch", "--locals",
}


def _default_log_path(label: str | None, cmd: list[str]) -> Path:
    base = label or Path(cmd[0]).name
    base = re.sub(r"[^A-Za-z0-9_.-]", "_", base) or "cmd"
    stamp = time.strftime("%Y%m%d-%H%M%S")
    tmpdir = Path(os.environ.get("TMPDIR") or tempfile.gettempdir())
    return tmpdir / "quiet" / f"{base}-{stamp}.log"


def _last_nonempty_line(text: str) -> str:
    for line in reversed(text.splitlines()):
        line = line.strip()
        if line:
            return line
    return ""


def _detect(output: str):
    """Return (detail, summary_ok). summary_ok is True/False when a known
    tool's summary was recognised, or None to fall back to the exit code
    alone."""
    lines = output.splitlines()

    # -- Python unittest ---------------------------------------------------
    ran_n = None
    ok_seen = False
    failed_paren = None
    first_fail = None
    for line in lines:
        s = line.strip()
        m = re.match(r"^Ran (\d+) tests?", s)
        if m:
            ran_n = m.group(1)
        if s == "OK" or re.match(r"^OK \(.*\)$", s):
            ok_seen = True
        m = re.match(r"^FAILED \((.*)\)$", s)
        if m:
            failed_paren = m.group(1)
        if first_fail is None:
            m = re.match(r"^(FAIL|ERROR): (.+)$", s)
            if m:
                first_fail = f"{m.group(1)}: {m.group(2)}"
    if ran_n is not None and (ok_seen or failed_paren is not None):
        if failed_paren is not None:
            detail = failed_paren
            if first_fail:
                detail = f"{detail} · {first_fail}"
            return detail, False
        return f"{ran_n} tests", True

    # -- pytest --------------------------------------------------------------
    # Two things this pattern has to get right, both of which it got wrong and
    # both found in the field (PhotoVault app, RQ-09 on its 2026-09-24 fix
    # list): `quiet` printed "FAILED · 2 failed" on a fully green gate, 1,522
    # passed and 0 failed, and OPERATING-RULES sends every session to read
    # exactly that line.
    #
    #   1. The word alternation had no trailing boundary, so `failed` matched
    #      the prefix of an application's own `failedBatches=0`. The line that
    #      did it was `... found=2 failedBatches=0 ...` -- "2 failed" to this
    #      regex.
    #   2. The search was unanchored and ran over every line in order, so the
    #      first line in the log that happened to look summary-shaped won,
    #      long before pytest printed its real one.
    #
    # So: word boundaries, and the summary must be the whole line (pytest pads
    # it with `=` and may append `in 1.23s`), not something found inside one.
    _WORD = r"(?:passed|failed|xfailed|xpassed|error|errors|skipped|deselected|warnings?)"
    _SUMMARY = re.compile(
        r"^=*\s*(\d+\s+" + _WORD + r"\b"
        r"(?:,\s*\d+\s+" + _WORD + r"\b)*)"
        r"(?:\s+in\s+[\d.]+s(?:\s*\([^)]*\))?)?\s*=*$"
    )
    for line in lines:
        m = _SUMMARY.match(line.strip())
        if m and ("passed" in m.group(1) or "failed" in m.group(1) or "error" in m.group(1)):
            summary = m.group(1)
            # Read the COUNTS, never the words. `"failed" in summary` was a
            # substring test, so a runner that spells its zeros out -- "426
            # passed, 0 failed, 0 errors", which the PhotoVault engine's
            # parallel merge gate prints per group -- could never report OK
            # however green it was. That is precisely the mistake this file's
            # own docstring warns about (`grep ... && git commit` shipped a
            # failing test because grep exits 0 on a line containing
            # "FAILED"), committed inside the checker meant to prevent it.
            # A zero is a zero.
            # Same boundary bug would live here too: without \b, a count of
            # `failedBatches` would be read as a count of failures.
            counts = re.findall(r"(\d+)\s+(" + _WORD + r")\b", summary)
            failed = any(int(n) > 0 for n, word in counts if word.startswith(("failed", "error")))
            return summary, not failed

    # -- flutter test ---------------------------------------------------------
    m = re.search(r"\+(\d+)(?:\s*-(\d+))?:\s*(All tests passed!|Some tests failed\.)", output)
    if m:
        counter = f"+{m.group(1)}" + (f" -{m.group(2)}" if m.group(2) else "")
        status = m.group(3)
        return f"{counter} {status}", status == "All tests passed!"

    # -- flutter/dart analyze --------------------------------------------------
    if "No issues found!" in output:
        return "No issues found!", True
    m = re.search(r"^(\d+) issues? found\.?$", output, re.MULTILINE)
    if m:
        return f"{m.group(1)} issues found", False

    # -- unknown: fall back to the last line, exit code decides -------------
    return _last_nonempty_line(output), None


def _parse_discover_cmd(cmd: list[str]):
    """If cmd is exactly `<python> -m unittest discover [OPTS...]`, return
    (python, start_dir, pattern). Otherwise None -- callers must then run
    cmd exactly as given, sequentially, never guess."""
    if len(cmd) < 3 or cmd[1:3] != ["-m", "unittest"]:
        return None
    rest = cmd[3:]
    if not rest or rest[0] != "discover":
        return None
    rest = rest[1:]
    start_dir = "."
    pattern = "test*.py"
    i = 0
    while i < len(rest):
        a = rest[i]
        if a in ("-s", "--start-directory"):
            if i + 1 >= len(rest):
                return None
            start_dir = rest[i + 1]
            i += 2
            continue
        if a.startswith("--start-directory="):
            start_dir = a.split("=", 1)[1]
            i += 1
            continue
        if a in ("-p", "--pattern"):
            if i + 1 >= len(rest):
                return None
            pattern = rest[i + 1]
            i += 2
            continue
        if a.startswith("--pattern="):
            pattern = a.split("=", 1)[1]
            i += 1
            continue
        if a in _NO_VALUE_DISCOVER_FLAGS:
            i += 1
            continue
        # Any other flag (e.g. -t/--top-level-directory) or stray
        # positional -- this parser does not know its shape, so it
        # refuses to shard rather than guess.
        return None
    return cmd[0], start_dir, pattern


_RAN_RE = re.compile(r"^Ran (\d+) tests? in [\d.]+s", re.MULTILINE)
_FAILED_RE = re.compile(r"^FAILED \((.*)\)\s*$", re.MULTILINE)
_COUNT_RE = re.compile(r"(failures|errors)=(\d+)")


def _shard_files(start_dir: str, pattern: str) -> list[Path]:
    base = Path(start_dir)
    return sorted(p for p in base.glob(pattern) if p.is_file())


def _auto_jobs() -> int:
    """os.cpu_count() - 2, floor 2 -- a sane default so a caller of
    `--jobs auto` (or a bare `--jobs`) does not have to pick a number."""
    n = os.cpu_count() or 2
    return max(2, n - 2)


def _repo_root_for(path: Path) -> Path:
    r = subprocess.run(["git", "-C", str(path), "rev-parse", "--show-toplevel"],
                        capture_output=True, text=True, timeout=10)
    if r.returncode == 0:
        return Path(r.stdout.strip())
    return path.resolve()


def _gitignores_cache_dir(root: Path) -> bool:
    gitignore = root / ".gitignore"
    if not gitignore.is_file():
        return False
    for line in gitignore.read_text(errors="replace").splitlines():
        s = line.strip()
        if s in (".cache/", ".cache"):
            return True
    return False


def _duration_cache_path(start_dir: Path) -> Path:
    """Same placement rule as tools/tracker/history.py's own cache (see its
    module docstring): inside the repo's .cache/ when that's already
    gitignored, else a file under the system temp dir keyed by the repo's
    absolute path, so nothing lands in the repo uninvited."""
    root = _repo_root_for(start_dir)
    if _gitignores_cache_dir(root):
        return root / ".cache" / "quiet-shard-durations.json"
    key = hashlib.sha256(str(root).encode()).hexdigest()[:16]
    return Path(tempfile.gettempdir()) / "common-rules-quiet-durations" / f"{key}.json"


def _load_duration_cache(path: Path) -> dict:
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return {}


def _save_duration_cache(path: Path, cache: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(cache, sort_keys=True))
    tmp.replace(path)


class Unit:
    """One shard: a whole test file, or some of one file's classes.

    Sharding by file alone has a floor -- the slowest single file. On this
    repo that floor was 575s of a ~1000s suite (finding 31/F-02), because
    tests/test_warmup.py calls bin/warmup 122 times at ~2s a call, and
    `discover -p <one file>` cannot be split further. A unit is therefore
    a file OR a named group of that file's test classes, which unittest
    runs as `python3 -m unittest module.ClassA module.ClassB`, printing
    the same summary the aggregator already reads.
    """

    def __init__(self, path: Path, classes: list[str] | None = None):
        self.path = path
        self.classes = classes or []

    @property
    def key(self) -> str:
        """The duration cache key. A split unit is keyed by its own
        classes, so a rerun can time each group rather than guessing."""
        if not self.classes:
            return self.path.name
        return f"{self.path.name}::{'+'.join(self.classes)}"

    @property
    def label(self) -> str:
        if not self.classes:
            return self.path.name
        return f"{self.path.name} [{', '.join(self.classes)}]"

    def argv(self, python: str, start_dir: str) -> list[str]:
        if not self.classes:
            return [python, "-m", "unittest", "discover", "-s", start_dir,
                    "-p", self.path.name, "-q"]
        module = self.path.stem
        return [python, "-m", "unittest", *(f"{module}.{c}" for c in self.classes), "-q"]

    def cwd(self, start_dir: str) -> str | None:
        # A named module is imported from the tests directory itself --
        # tests/ is not a package here, so the module name is bare and the
        # process has to start in that directory.
        return start_dir if self.classes else None


def _test_classes(path: Path) -> list[str]:
    """Every class in `path` that holds at least one test method, read from
    the source with `ast` -- never by importing the file, which would run
    its module-level code in this process."""
    try:
        tree = ast.parse(path.read_text(errors="replace"))
    except (OSError, SyntaxError):
        return []
    found = []
    for node in tree.body:
        if not isinstance(node, ast.ClassDef):
            continue
        if any(isinstance(b, ast.FunctionDef) and b.name.startswith("test")
               for b in node.body):
            found.append(node.name)
    return found


def _run_one_shard(python: str, start_dir: str, unit: "Unit"):
    t0 = time.monotonic()
    proc = subprocess.run(unit.argv(python, start_dir), cwd=unit.cwd(start_dir),
                          capture_output=True, text=True)
    return unit, proc.returncode, proc.stdout + proc.stderr, time.monotonic() - t0


def _ordered_shards(units: list["Unit"], durations: dict) -> list["Unit"]:
    """Longest-known-first (see the module docstring): unknown units (cold
    cache, or one that never ran before) get -1 so they sort after every
    timed unit, in the incoming (already-alphabetical) order -- a plain
    round-robin among themselves. A pure function of its inputs so the
    dispatch order can be checked without running any tests."""
    return sorted(units, key=lambda u: durations.get(u.key, -1.0), reverse=True)


def _file_duration(path: Path, durations: dict) -> float:
    """What the cache knows about a whole file: its own timing, or the sum
    of its split units' timings from the last run."""
    if path.name in durations:
        return float(durations[path.name])
    prefix = f"{path.name}::"
    parts = [v for k, v in durations.items() if k.startswith(prefix)]
    return float(sum(parts)) if parts else -1.0


def _plan_units(files: list[Path], durations: dict, jobs: int) -> list["Unit"]:
    """Files, with any file too slow to be one shard split across its test
    classes.

    "Too slow" is measured against the only target that matters: the wall
    clock a perfectly balanced run would reach, which is the total known
    work divided by the number of processes. A file above that target is
    the run's floor, so it is cut into ceil(duration / target) groups. With
    a cold cache nothing is split -- there is no evidence yet to act on,
    and the first run writes the timings the next one uses.
    """
    known = {f: _file_duration(f, durations) for f in files}
    timed = [d for d in known.values() if d > 0]
    if jobs < 2 or not timed:
        return [Unit(f) for f in files]
    target = sum(timed) / jobs
    units: list[Unit] = []
    for f in files:
        d = known[f]
        if d <= target or target <= 0:
            units.append(Unit(f))
            continue
        classes = _test_classes(f)
        groups = min(len(classes), math.ceil(d / target))
        if groups < 2:
            units.append(Unit(f))
            continue
        # Round-robin, because per-class timings are not known: it spreads
        # a file's big and small classes across the groups rather than
        # leaving all the slow ones together at the end.
        buckets: list[list[str]] = [[] for _ in range(groups)]
        for n, c in enumerate(classes):
            buckets[n % groups].append(c)
        units.extend(Unit(f, b) for b in buckets if b)
    return units


def _run_parallel_discover(python: str, start_dir: str, pattern: str, jobs: int):
    """Run one shard per unit -- a test file, or a group of one file's
    classes when that file is the run's floor -- across up to `jobs` OS
    processes at once, and return (combined_output, exit_code) in the same
    unittest summary shape `_detect` already parses, or None if no files
    matched (the caller then falls back to running CMD as given)."""
    files = _shard_files(start_dir, pattern)
    if not files:
        return None

    cache_path = _duration_cache_path(Path(start_dir))
    durations = _load_duration_cache(cache_path)
    units = _plan_units(files, durations, jobs)
    jobs = max(1, min(jobs, len(units)))
    ordered = _ordered_shards(units, durations)

    shard_start = time.monotonic()
    results = []
    with concurrent.futures.ThreadPoolExecutor(max_workers=jobs) as ex:
        futures = [ex.submit(_run_one_shard, python, start_dir, u) for u in ordered]
        for fut in futures:
            results.append(fut.result())
    shard_elapsed = time.monotonic() - shard_start

    new_durations = {k: v for k, v in durations.items()
                     if k not in {u.key for u in units}
                     and k.split("::")[0] not in {u.path.name for u in units}}
    for unit, code, out, elapsed in results:
        new_durations[unit.key] = elapsed
    _save_duration_cache(cache_path, new_durations)

    total_tests = 0
    total_failures = 0
    total_errors = 0
    any_unrecognised_failure = False
    parts = []
    for unit, code, out, elapsed in results:
        parts.append(f"--- {unit.label} ---\n{out.rstrip(chr(10))}\n")
        m = _RAN_RE.search(out)
        if m:
            total_tests += int(m.group(1))
        fm = _FAILED_RE.search(out)
        if fm:
            for kind, n in _COUNT_RE.findall(fm.group(1)):
                if kind == "failures":
                    total_failures += int(n)
                else:
                    total_errors += int(n)
        elif code != 0:
            # Exited non-zero but printed nothing this parser recognises
            # (e.g. a collection-time traceback) -- never read that as OK.
            any_unrecognised_failure = True

    failed = total_failures > 0 or total_errors > 0 or any_unrecognised_failure
    if failed and total_failures == 0 and total_errors == 0:
        total_errors = 1

    summary = f"Ran {total_tests} tests in {shard_elapsed:.3f}s\n\n" + (
        f"FAILED (failures={total_failures}, errors={total_errors})" if failed else "OK"
    )
    combined_output = "\n".join(parts) + "\n" + summary + "\n"
    return combined_output, (1 if failed else 0)

def _parse_args(argv):
    log = None
    label = None
    jobs = None
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--":
            i += 1
            break
        if a in ("-h", "--help"):
            print(__doc__.strip())
            raise SystemExit(0)
        if a == "--log":
            if i + 1 >= len(argv):
                print("quiet: --log requires a value", file=sys.stderr)
                raise SystemExit(2)
            log = argv[i + 1]
            i += 2
            continue
        if a == "--label":
            if i + 1 >= len(argv):
                print("quiet: --label requires a value", file=sys.stderr)
                raise SystemExit(2)
            label = argv[i + 1]
            i += 2
            continue
        if a == "--jobs":
            # A bare trailing --jobs (nothing after it, or immediately
            # followed by the -- that introduces CMD) means "auto", same
            # as an explicit --jobs auto -- see _auto_jobs().
            if i + 1 >= len(argv) or argv[i + 1] == "--":
                jobs = _auto_jobs()
                i += 1
                continue
            value = argv[i + 1]
            if value == "auto":
                jobs = _auto_jobs()
            else:
                try:
                    jobs = int(value)
                except ValueError:
                    print(f"quiet: --jobs wants an integer or 'auto', got {value!r}", file=sys.stderr)
                    raise SystemExit(2)
            i += 2
            continue
        print(f"quiet: unknown option {a!r} (expected -- before the command)", file=sys.stderr)
        raise SystemExit(2)
    cmd = argv[i:]
    return log, label, jobs, cmd


def main(argv):
    log, label, jobs, cmd = _parse_args(argv)
    if not cmd:
        print("quiet: no command given -- usage: quiet [--log FILE] [--label NAME] [--jobs N] -- CMD [ARGS...]",
              file=sys.stderr)
        return 2

    log_path = Path(log) if log else _default_log_path(label, cmd)
    log_path.parent.mkdir(parents=True, exist_ok=True)

    parsed_discover = _parse_discover_cmd(cmd) if jobs and jobs > 1 else None

    start = time.monotonic()
    if parsed_discover:
        python, start_dir, pattern = parsed_discover
        parallel_result = _run_parallel_discover(python, start_dir, pattern, jobs)
    else:
        parallel_result = None

    if parallel_result is not None:
        combined_output, exit_code = parallel_result
        try:
            log_path.write_text(combined_output)
        except OSError:
            pass
    else:
        try:
            with open(log_path, "w") as fh:
                proc = subprocess.run(cmd, stdout=fh, stderr=subprocess.STDOUT)
            exit_code = proc.returncode
        except OSError as exc:
            elapsed = time.monotonic() - start
            try:
                with open(log_path, "a") as fh:
                    fh.write(f"quiet: could not start {cmd[0]!r}: {exc}\n")
            except OSError:
                pass
            detail = f"could not start: {cmd[0]}"[:DETAIL_MAX]
            print(f"quiet: FAILED · {detail} · {elapsed:.1f}s · log {log_path}")
            return 2

    elapsed = time.monotonic() - start
    try:
        output = log_path.read_text(errors="replace")
    except OSError:
        output = ""

    detail, summary_ok = _detect(output)
    ok = (exit_code == 0) if summary_ok is None else (summary_ok and exit_code == 0)
    detail = detail.replace("\n", " ").strip()
    if len(detail) > DETAIL_MAX:
        detail = detail[:DETAIL_MAX]

    verdict = "OK" if ok else "FAILED"
    print(f"quiet: {verdict} · {detail} · {elapsed:.1f}s · log {log_path}")
    return exit_code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
