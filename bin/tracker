#!/usr/bin/env python3
"""tracker -- the proposal ledger, one tool for every project (proposal 19).

  tracker validate [LEDGER.json ...]   is the ledger well-formed?  (default: every ledger in docs/proposals)
  tracker render   ...                 ledger.json -> the proposal's page          (W-02)
  tracker check    ...                 did the ledger move with the code?          (W-03)
  tracker sync     ...                 mirror items to GitHub issues, one way      (W-04)
  tracker checkpoint ...               write docs/handovers/<date>-checkpoint.md   (W-07)
  tracker import   ...                 an existing plan -> a ledger                (W-09)
  tracker board [--project DIR] [--check]
                                       every ledger -> the project's one tracker page (P22 T-01)
  tracker published --project [DIR] --url URL [--by NAME]
                                       record the project page a session just       (P22 T-03)
                                       published: docs/proposals/tracker/index.html
  tracker published LEDGER.json --url URL [--by NAME] [--page PATH]
                                       record a page of its own: a ledger that       (P20 V-09;
                                       records `tracker.own`, or the declared         V-11;
                                       plan_page with --page                          P22 T-03)
  tracker set LEDGER ITEM_ID [--status S] [--owner O] [--field K=V ...]
                              [--event TEXT] [--evidence TEXT] [--by NAME] [--at ISO]
                                       change one item, log it, re-render the page (P23 L-04)
  tracker ask LEDGER --kind KIND --quote TEXT [--state S] [--by NAME] [--at ISO]
                      [--owner O] [--became ITEM] [--source TEXT] [--note TEXT]
                                       record a sponsor ask as the next A-nn (P23 L-04)
  tracker route LEDGER ITEM_ID [--project DIR] [--json]
                                       how one item is reviewed and bundled   (P25 Z-02)
  tracker lanes LEDGER... [--project DIR] [--json]
                                       share, risk, the 80% cut, each item's lane (P26 C-02)
  tracker stage LEDGER ITEM_ID [--status S] [--owner O] [--field K=V ...]
                                [--event TEXT] [--evidence TEXT] [--by NAME] [--at ISO]
                                       an item lead or builder records an intended
                                       change without touching the ledger      (P23 M-04)
  tracker apply-staged LEDGER         the dispatcher applies every staged change,
                                       one at a time, deleting each as it lands (P23 M-04)
  tracker findings add|decide|defer|decline LEDGER ...
                                       findings-as-ledger-rows: catalogue,
                                       decide, defer or decline one         (P26 C-05)
  tracker findings lanes LEDGER... [--project DIR] [--json]
                                       items and findings in one shared
                                       share/risk queue                     (P26 C-05)
  tracker findings triage LEDGER --batch ID [ID ...] [--json]
                                       group a batch of decided-small
                                       findings by shared root cause        (P26 C-05)
  tracker rescore LEDGER [--project DIR] [--at DATE] [--json]
                                       14-day next_check dates for tail-lane
                                       items (Daily/Weekly/When touched)    (P26 C-04)
  tracker history [--project DIR] [--json] [--since YYYY-MM-DD]
                                       progress over time, from the ledgers'
                                       own git history -- no AI updates    (P30 P-07)
  tracker trace LEDGER TRACE_ID [--status S] [--receipt TEXT] [--owner O]
                                       update a validated traceability receipt
                                       without hand-editing ledger JSON

Each command is a module in tools/tracker/ with a `main(argv) -> int`, so
commands built in parallel never edit the same file.

Exit codes follow the rest of bin/: 0 fine, 1 a finding, 2 could not check.
"""
import importlib
import sys
from pathlib import Path

RULES_DIR = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(RULES_DIR))

COMMANDS = ("validate", "render", "check", "sync", "checkpoint", "import", "published", "board", "set", "ask",
            "route", "lanes", "stage", "apply-staged", "findings", "rescore", "history", "trace")


def validate(argv):
    from tools.tracker import ledger
    paths = [Path(a) for a in argv] or ledger.find(Path.cwd())
    if not paths:
        print("tracker validate: no ledgers under docs/proposals", file=sys.stderr)
        return 2
    bad = 0
    for p in paths:
        try:
            problems = ledger.validate(ledger.load(p))
        except (OSError, ValueError) as exc:
            print(f"{p}: {exc}", file=sys.stderr)
            return 2
        if problems:
            bad += 1
            print(f"{p}: {len(problems)} problem(s)")
            for line in problems:
                print(f"  {line}")
        else:
            print(f"{p}: well-formed · {ledger.status_line(ledger.load(p))}")
    return 1 if bad else 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    cmd, rest = argv[0], argv[1:]
    if cmd not in COMMANDS:
        print(f"tracker: unknown command {cmd!r}; one of {', '.join(COMMANDS)}", file=sys.stderr)
        return 2
    if cmd == "validate":
        return validate(rest)
    if cmd == "published":
        # Lives beside render, whose page digest it records (proposal 20, V-09).
        from tools.tracker import render
        return render.published_main(rest)
    module = {"import": "import_", "apply-staged": "apply_staged"}.get(cmd, cmd)
    try:
        mod = importlib.import_module(f"tools.tracker.{module}")
    except ModuleNotFoundError:
        print(f"tracker {cmd}: not built yet (proposal 19)", file=sys.stderr)
        return 2
    return mod.main(rest)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
